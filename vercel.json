{
  "version": 2,
  "name": "novaedge-relay",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/my-relay-path",
      "destination": "/api/relay"
    },
    {
      "source": "/my-relay-path/:path*",
      "destination": "/api/relay"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/platform",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    }
  ]
}
